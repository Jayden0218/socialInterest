# Copy to `.env.local` and fill in. `.env.local` is gitignored; keep it that way.
#
# Nothing in here belongs in the repository, in a commit message, or in a chat
# window. The one time this project shipped a credential in a file — a JWT
# signing secret with a default — anybody who read the repository could mint a
# token the service would accept.

# ── Supabase: the database ───────────────────────────────────────────────────
# Supabase → Connect → SESSION POOLER. Not the direct connection (IPv6 only, and
# home networks are IPv4) and not the transaction pooler (it breaks a long-lived
# connection pool, which is exactly what the API opens).
DATABASE_URL=
DATABASE_SSL=true

# ── Supabase: the photographs ────────────────────────────────────────────────
# Supabase → Storage → S3 access keys. The bucket must be PRIVATE: every image
# URL is signed for 15 minutes and issued only after the visibility boundary has
# decided the viewer may see that post. A public bucket hands out permanent
# unguarded links to private photographs.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_BUCKET=sih-media

# ── Identity ─────────────────────────────────────────────────────────────────
# Generate once, then leave it alone: `openssl rand -hex 32`
# Changing it invalidates every token, which signs your phone out.
LOCAL_JWT_SECRET=
