{
  "name": "socialinterest",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @sih/api test",
    "test:unit": "pnpm --filter @sih/api test:unit",
    "test:contract": "pnpm --filter @sih/api test:contract",
    "test:visibility": "pnpm --filter @sih/api test:visibility",
    "test:integration": "pnpm --filter @sih/api test:integration",
    "verify:local": "pnpm --filter @sih/infra verify:local"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
