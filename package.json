{
  "name": "socialinterest",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "laptop": "scripts/laptop-up.sh",
    "doctor": "scripts/doctor.sh",
    "_comment_mint_token": "NOT `token`: pnpm has a BUILTIN `token` command (npm auth tokens), which shadows a script of that name silently — `pnpm token` printed `npm error 401 Unauthorized` while a dozen documents told people to run it. A colon-namespaced name cannot collide.",
    "mint:token": "scripts/mint-token.sh",
    "seed:demo": "scripts/seed-demo.sh",
    "lint": "eslint .",
    "test": "pnpm --filter @sih/api test && pnpm --filter @sih/mobile test",
    "test:unit": "pnpm --filter @sih/api test:unit",
    "test:contract": "pnpm --filter @sih/api test:contract",
    "test:visibility": "pnpm --filter @sih/api test:visibility",
    "test:integration": "pnpm --filter @sih/api test:integration",
    "verify:local": "pnpm --filter @sih/infra verify:local && pnpm verify:register",
    "verify:register": "node scripts/verify-divergence-register.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^10.10.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  }
}
