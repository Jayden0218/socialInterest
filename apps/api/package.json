{
  "name": "@sih/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:contract": "jest --selectProjects contract",
    "test:visibility": "jest --selectProjects visibility",
    "test:integration": "jest --selectProjects integration",
    "smoke:boot": "tsx scripts/smoke-boot.ts",
    "bench:feed": "tsx bench/feed.bench.ts",
    "bench:upload": "tsx bench/upload.bench.ts",
    "bench:transcode": "tsx bench/transcode.bench.ts",
    "bench:feed-load": "tsx bench/feed-load.bench.ts",
    "bench:ceiling": "tsx bench/ceiling.bench.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1127.0",
    "@aws-sdk/client-dynamodb": "^3.712.0",
    "@aws-sdk/client-mediaconvert": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/cloudfront-signer": "^3.1125.0",
    "@aws-sdk/lib-dynamodb": "^3.712.0",
    "@aws-sdk/s3-request-presigner": "^3.712.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@sih/shared": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@sih/workers": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.6.1"
  }
