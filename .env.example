# The local runtime profile. `RUNTIME_PROFILE` accepts `local` only and says so
# if given anything else: the four AWS adapters were deleted in 2026-09 because
# four implementations selected by an env var is how a defect hides, so there is
# one implementation per port and it is the one every test exercises.
RUNTIME_PROFILE=local

# The datastore. Postgres since 010 — D3 is reversed and D9 is retired, and
# DynamoDB Local is out of docker-compose.yml entirely. This is the LOCAL
# container's connection string, which is written in docker-compose.yml where
# anybody reading this repository can already see it; a hosted deployment
# supplies its own from the environment and never from a file (FR-016).
DATABASE_URL=postgres://sih:localsecret@127.0.0.1:5432/sih

# The two pool settings `pg-pool.ts` reads, absent from this file until 2026-09-16
# and both of them hosted concerns — which is exactly why they were missed: every
# reader of this file so far has been pointed at a container on loopback.
#
# `DATABASE_SSL=true` is required by every managed Postgres (Supabase among them)
# and sets `rejectUnauthorized: false`, because the provider terminates TLS with
# its own chain. Leave it unset locally; the local container speaks plaintext and
# `true` against it fails to connect at all.
# DATABASE_SSL=true
#
# `DATABASE_POOL_MAX` defaults to 8. A free managed database has a connection
# ceiling far below what a pool will happily open, and exhausting it does not
# fail the deploy — it fails the request that happens to be unlucky. Size it
# under the provider's stated limit, not over it.
# DATABASE_POOL_MAX=8

# Unused by this engine, which has one table. It is still passed to every
# repository for one release so that replacing the engine and re-signing
# twenty-nine constructors are two changes rather than one.
TABLE_NAME=sih-main

# Object storage. MinIO in docker-compose.yml; `adobe/s3mock` where quay.io is
# unreachable — see docker-compose.s3mock.yml.
S3_ENDPOINT=http://127.0.0.1:9000
# The address a CLIENT uses, which is not always the address the service uses:
# a presigned signature covers the Host header, so a URL cannot be rewritten
# after signing. On an emulator run this is the host alias, not loopback.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=local
MEDIA_BUCKET=sih-media
S3_ACCESS_KEY_ID=localkey
S3_SECRET_ACCESS_KEY=localsecret
S3_FORCE_PATH_STYLE=true

# Identity. LOCAL_JWT_SECRET HAS NO DEFAULT AND NO PLACEHOLDER HERE, on purpose:
# the old default was a constant in this repository, so anyone who read it could
# mint a token the service accepted (003/FR-007). The service also refuses that
# exact published value if it sees it again. Generate your own:
#
#   echo "LOCAL_JWT_SECRET=$(openssl rand -hex 32)" >> .env.local
#
LOCAL_JWT_SECRET=
JWT_ISSUER=sih-local

# Media processing. The API executes these as BINARIES (010/T026) — it used to
# shell out to `docker run`, which no managed host allows. Leave them unset to
# use whatever `ffmpeg`/`ffprobe` are on PATH. Where `apt-get install ffmpeg` is
# blocked, `scripts/ffmpeg-shim/` puts a container-backed pair on PATH instead,
# which keeps that variation outside the code where it can be read.
# FFMPEG_PATH=
# FFPROBE_PATH=

# The port. A managed host usually injects `PORT` instead, and the service reads
# `API_PORT` first, then `PORT`, then 3000.
API_PORT=3000
