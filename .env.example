# Runtime profile: `local` (Docker: DynamoDB Local + MinIO + ffmpeg) or `aws`.
# Research D9. The local profile needs no AWS account and no credentials.
RUNTIME_PROFILE=local

# DynamoDB - same API in both profiles, so no adapter exists for it (D9).
DYNAMO_ENDPOINT=http://127.0.0.1:8000
DYNAMO_REGION=local
TABLE_NAME=sih-main

# Object store - MinIO locally, S3 in aws.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=local
MEDIA_BUCKET=sih-media
S3_ACCESS_KEY_ID=localkey
S3_SECRET_ACCESS_KEY=localsecret
S3_FORCE_PATH_STYLE=true

# Identity - local JWT issuer locally, Cognito in aws.
LOCAL_JWT_SECRET=dev-only-not-a-real-secret
JWT_ISSUER=sih-local

# Media processing - ffmpeg container locally, MediaConvert in aws.
FFMPEG_IMAGE=linuxserver/ffmpeg:latest

API_PORT=3000
