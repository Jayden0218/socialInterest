node_modules/
dist/
.env
.env.local
*.log
infra/cdk.out/
.expo/
apps/mobile/web/dist/

# Generated by `expo prebuild` (Continuous Native Generation). Regenerate with
# `pnpm --filter @sih/mobile exec expo prebuild --platform android`. Committing it
# would mean hand-maintaining native code that prebuild overwrites.
apps/mobile/android/
apps/mobile/ios/

# Evidence captured by the Android device-pass job; uploaded as a CI artifact.
artifacts/

# Playwright/e2e run artefacts — machine-local, never a review artefact.
apps/e2e/test-results/

# Built APKs. A 21 MB binary that is regenerated by one command does not belong
# in the history, and git keeps it forever once it is in.
*.apk

# The seeded design canvas — ~2 MB of editor payload regenerated from the
# .dc.html artboards beside it by seed-canvas.mjs. The artboards are the source.
design/*/[a-z]*-redesign.html

# The compose override compose picks up automatically. `docker-compose.s3mock.yml`
# is the one to copy into it locally; a substitute for a backing service must
# never reach CI by being committed.
docker-compose.override.yml
